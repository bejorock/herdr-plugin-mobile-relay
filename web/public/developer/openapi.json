    "/api/subscribe": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Register a Web Push subscription",
        "description": "Submit the standard browser PushSubscription JSON object. Requires an authorized device.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "endpoint",
                  "keys"
                ],
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "format": "uri"
                  },
                  "keys": {
                    "type": "object",
                    "properties": {
                      "p256dh": {
                        "type": "string"
                      },
                      "auth": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Stored"
          }
        }
      },
      "delete": {
        "tags": [
          "Notifications"
        ],
        "summary": "Remove a Web Push subscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "endpoint"
                ],
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Removed"
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Upgrade to raw terminal/control WebSocket",
        "description": "This endpoint requires `Upgrade: websocket`. It is documented in the API introduction rather than represented as OpenAPI messages.",
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted"
          },
          "426": {
            "description": "WebSocket upgrade required"
          }
        }
      }
    },
    "/acp": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Upgrade to the ACP v2 JSON-RPC WebSocket",
        "description": "Read the full ACP WebSocket guide before implementing this endpoint.",
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted"
          },
          "426": {
            "description": "WebSocket upgrade required"
          }
        }
      }
    },
    "/api/push-test": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Send a diagnostic Web Push notification",
        "description": "Requires push to be configured, an authorized device, and at least one stored subscription.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "paneId": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "At least one subscriber accepted delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "subscribers"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "subscribers": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Push is disabled or no client is subscribed."
          }
        }
      }
    }
  },
