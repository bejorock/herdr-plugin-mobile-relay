          "type": "string"
        }
      },
      "PaneId": {
        "name": "paneId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PaneIdQuery": {
        "name": "paneId",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "WorkspaceId": {
        "name": "workspaceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TabId": {
        "name": "tabId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Lines": {
        "name": "lines",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 200
        }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Access, origin, identity, or device authorization was rejected.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Action": {
        "description": "Herdr mutation outcome",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ActionResponse"
            }
          }
        }
      },
      "Create": {
        "description": "Creation result",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreateResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "RequestId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$",
        "description": "Optional idempotency key for supported mutations."
      },
      "ActionResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok"
            ],
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "ok",
              "error"
            ],
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "string"
              },
              "textDelivered": {
                "type": "boolean"
              },
              "deliveryAmbiguous": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "ReplyRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "default": ""
          },
          "submit": {
            "type": "boolean",
            "default": true
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "UploadResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "path"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "path": {
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/Error"
          }
        ]
      },
      "CreatedPane": {
        "type": "object",
        "required": [
          "paneId",
          "workspaceId",
          "workspaceLabel",
          "tabId",
          "cwd"
        ],
        "properties": {
          "paneId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "workspaceLabel": {
            "type": "string"
          },
          "tabId": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          }
        }
      },
      "CreateResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "pane"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "pane": {
                "$ref": "#/components/schemas/CreatedPane"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ActionResponse"
          }
        ]
      },
      "CreateTabRequest": {
        "type": "object",
        "required": [
          "workspaceId"
        ],
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "Defaults to the relay host user's home directory."
          },
          "label": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "CreateWorktreeRequest": {
        "type": "object",
        "required": [
          "workspaceId"
        ],
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "PaneRead": {
        "type": "object",
        "required": [
          "paneId",
          "text",
          "truncated",
          "revision"
        ],
        "properties": {
          "paneId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "ANSI/SGR terminal output."
          },
          "truncated": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "BridgeConfig": {
        "type": "object",
        "required": [
          "push",
          "vapidPublicKey"
        ],
        "properties": {
          "push": {
            "type": "boolean"
          },
          "vapidPublicKey": {
            "type": "string"
          },
          "acp": {
            "type": "boolean"
          },
          "build": {
            "type": "string"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "bridge",
          "agents",
          "shellPanes",
          "workspaces",
          "tabs",
          "sessions",
          "ts"
        ],
        "properties": {
          "bridge": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ]
          },
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "shellPanes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "workspaces": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tabs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "isPrimary": {
                  "type": "boolean"
                },
                "reachable": {
                  "type": "boolean"
                },
                "agents": {
                  "type": "integer"
                },
                "working": {
                  "type": "integer"
                },
                "blocked": {
                  "type": "integer"
                }
              }
            }
          },
          "ts": {
            "type": "integer"
          }
        }
      },
      "Agent": {
        "type": "object",
        "properties": {
          "paneId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "workspaceLabel": {
            "type": "string"
          },
          "tabId": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "working",
              "blocked",
              "done",
              "unknown"
            ]
          },
          "cwd": {
            "type": "string"
          },
          "focused": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent",
              "shell"
            ]
          }
        }
      },
      "WorkspaceFiles": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "directory"
                  ]
                }
              }
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "WorkspaceFile": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "content": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "GitStatus": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "isRepo": {
            "type": "boolean"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream": {
            "type": [
              "string",
              "null"
            ]
          },
          "ahead": {
            "type": "integer"
          },
          "behind": {
            "type": "integer"
          },
          "insertions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GitDiff": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "NotifyPrefs": {
        "type": "object",
        "properties": {
          "blocked": {
            "type": "boolean"
          },
          "done": {
            "type": "boolean"
          },
          "updates": {
            "type": "boolean"
          }
        }
      },
      "UpdateStatus": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "lastCheckSucceeded": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "current": {
            "type": "string"
          },
          "latest": {
            "type": [
              "string",
              "null"
            ]
          },
          "latestUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseAvailable": {
            "type": "boolean"
          },
          "bridgeStale": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "TailscaleServeIdentity": {
        "type": "apiKey",
        "in": "header",
        "name": "Tailscale-User-Login",
        "description": "Injected by Tailscale Serve for remote traffic. Do not manufacture this header; configure `COLLIE_TRUSTED_USER` on the relay."
      },
      "NativeMutation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Herdr-Client",
        "description": "Set to `herdr-mobile-v1` only for a native non-browser mutation without an Origin header. Browser requests use same-origin protection instead."
      }
    }
  }
}
