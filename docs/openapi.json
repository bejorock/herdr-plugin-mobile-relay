{
  "openapi": "3.1.0",
  "info": {
    "title": "Herdr Mobile Relay REST API",
    "version": "2.0.1",
    "description": "Lean Herdr HTTP API and optional terminal WebSocket. No bundled UI, browser push, or ACP endpoint."
  },
  "servers": [
    {
      "url": "/",
      "description": "Relay HTTP origin"
    }
  ],
  "tags": [
    {
      "name": "State",
      "description": "Authoritative snapshots and relay capabilities."
    },
    {
      "name": "Panes",
      "description": "Read and drive terminal panes."
    },
    {
      "name": "Workspace",
      "description": "Workspace, tab, worktree, file and Git operations."
    },
    {
      "name": "Conversations",
      "description": "HTTP native conversation lifecycle; no transcript or interaction endpoints yet."
    }
  ],
  "paths": {
    "/api/snapshot": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Read the current Herdr snapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "Current panes, workspaces, tabs and relay status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Read relay capabilities",
        "responses": {
          "200": {
            "description": "Capability and build information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/pane/{paneId}": {
      "get": {
        "tags": [
          "Panes"
        ],
        "summary": "Read bounded recent pane output",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Lines"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "ANSI terminal text and Herdr revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaneRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/pane/{paneId}/reply": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Type a reply and optionally submit it",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mutation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/pane/{paneId}/input": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Type raw terminal input without submitting",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/pane/{paneId}/submit": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Type terminal data and one submit key",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data",
                  "key"
                ],
                "properties": {
                  "data": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "key": {
                    "type": "string",
                    "enum": [
                      "Enter",
                      "Tab"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/pane/{paneId}/keys": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Send terminal key names",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "keys"
                ],
                "properties": {
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/pane/{paneId}/upload": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Store an image for an agent to reference",
        "description": "Accepted image MIME types: PNG, JPEG, WebP, GIF. Maximum file size: 10 MiB. The returned host path is for local terminal use; do not expose it to untrusted remote clients.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/pane/{paneId}/close": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Close a pane",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/tab": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create a tab with a fresh shell pane",
        "parameters": [
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTabRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Create"
          }
        }
      }
    },
    "/api/tab/{tabId}": {
      "patch": {
        "tags": [
          "Workspace"
        ],
        "summary": "Rename a tab",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      },
      "delete": {
        "tags": [
          "Workspace"
        ],
        "summary": "Close a tab",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/workspace": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create a workspace",
        "parameters": [
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Create"
          }
        }
      }
    },
    "/api/workspace/{workspaceId}": {
      "delete": {
        "tags": [
          "Workspace"
        ],
        "summary": "Close a workspace",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/worktree": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Create a linked Git worktree",
        "parameters": [
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorktreeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Create"
          }
        }
      }
    },
    "/api/worktree/{workspaceId}": {
      "delete": {
        "tags": [
          "Workspace"
        ],
        "summary": "Remove a linked worktree",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "force": {
                    "type": "boolean",
                    "default": false
                  },
                  "requestId": {
                    "$ref": "#/components/schemas/RequestId"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/focus/{paneId}": {
      "post": {
        "tags": [
          "Panes"
        ],
        "summary": "Focus a pane in Herdr",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaneId"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Action"
          }
        }
      }
    },
    "/api/workspace/{workspaceId}/files": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "List bounded workspace files",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/PaneIdQuery"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace-relative entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceFiles"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/{workspaceId}/file": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Read a bounded workspace file preview",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PaneIdQuery"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 or base64 content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceFile"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/{workspaceId}/git": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Read workspace Git status",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/PaneIdQuery"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/{workspaceId}/diff": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Read a bounded unified Git diff",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PaneIdQuery"
          },
          {
            "$ref": "#/components/parameters/Session"
          }
        ],
        "responses": {
          "200": {
            "description": "Unified patch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitDiff"
                }
              }
            }
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Upgrade to raw terminal/control WebSocket",
        "description": "This endpoint requires `Upgrade: websocket`. It is documented in the API introduction rather than represented as OpenAPI messages.",
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted"
          },
          "426": {
            "description": "WebSocket upgrade required"
          }
        }
      }
    },
    "/api/agent-kinds": {
      "get": {
        "tags": [
          "Conversations"
        ],
        "summary": "Discover Pi and Claude using Herdr integration evidence",
        "description": "See HTTP_LIFECYCLE.md for identity, failure, retention and interrupted-launch semantics. No ACP.",
        "parameters": [
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Discovered Herdr runtime; absent selects primary for discovery/create, saved runtime for existing conversation."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentKinds"
                }
              }
            }
          },
          "400": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "404": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "409": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "500": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "502": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "503": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "403": {
            "description": "Existing host/origin/device access gate denied request (plain text)."
          }
        }
      }
    },
    "/api/conversations": {
      "post": {
        "tags": [
          "Conversations"
        ],
        "summary": "Create and privately persist a native conversation",
        "description": "See HTTP_LIFECYCLE.md for identity, failure, retention and interrupted-launch semantics. No ACP.",
        "parameters": [
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Discovered Herdr runtime; absent selects primary for discovery/create, saved runtime for existing conversation."
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResult"
                }
              }
            }
          },
          "400": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "404": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "409": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "500": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "502": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "503": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "403": {
            "description": "Existing host/origin/device access gate denied request (plain text)."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "cwd",
                  "requestId"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "pi",
                      "claude"
                    ]
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "requestId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}": {
      "get": {
        "tags": [
          "Conversations"
        ],
        "summary": "Read current attachment without launching",
        "description": "See HTTP_LIFECYCLE.md for identity, failure, retention and interrupted-launch semantics. No ACP.",
        "parameters": [
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Discovered Herdr runtime; absent selects primary for discovery/create, saved runtime for existing conversation."
          },
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResult"
                }
              }
            }
          },
          "400": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "404": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "409": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "500": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "502": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "503": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "403": {
            "description": "Existing host/origin/device access gate denied request (plain text)."
          }
        }
      }
    },
    "/api/conversations/{conversationId}/resume": {
      "post": {
        "tags": [
          "Conversations"
        ],
        "summary": "Reconnect or restore the saved native conversation",
        "description": "See HTTP_LIFECYCLE.md for identity, failure, retention and interrupted-launch semantics. No ACP.",
        "parameters": [
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Discovered Herdr runtime; absent selects primary for discovery/create, saved runtime for existing conversation."
          },
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResult"
                }
              }
            }
          },
          "400": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "404": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "409": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "500": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "502": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "503": {
            "description": "Structured lifecycle failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleError"
                }
              }
            }
          },
          "403": {
            "description": "Existing host/origin/device access gate denied request (plain text)."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cwd"
                ],
                "properties": {
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Session": {
        "name": "session",
        "in": "query",
        "description": "Known relay session name; omit for the primary session.",
        "schema": {
          "type": "string"
        }
      },
      "PaneId": {
        "name": "paneId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PaneIdQuery": {
        "name": "paneId",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "WorkspaceId": {
        "name": "workspaceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TabId": {
        "name": "tabId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Lines": {
        "name": "lines",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 200
        }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Access, origin, identity, or device authorization was rejected.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Action": {
        "description": "Herdr mutation outcome",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ActionResponse"
            }
          }
        }
      },
      "Create": {
        "description": "Creation result",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreateResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "RequestId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$",
        "description": "Optional idempotency key for supported mutations."
      },
      "ActionResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok"
            ],
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "ok",
              "error"
            ],
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "string"
              },
              "textDelivered": {
                "type": "boolean"
              },
              "deliveryAmbiguous": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "ReplyRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "default": ""
          },
          "submit": {
            "type": "boolean",
            "default": true
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "UploadResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "path"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "path": {
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/Error"
          }
        ]
      },
      "CreateTabRequest": {
        "type": "object",
        "required": [
          "workspaceId"
        ],
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "Defaults to the relay host user's home directory."
          },
          "label": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "CreateWorktreeRequest": {
        "type": "object",
        "required": [
          "workspaceId"
        ],
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "PaneRead": {
        "type": "object",
        "required": [
          "paneId",
          "text",
          "truncated",
          "revision"
        ],
        "properties": {
          "paneId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "ANSI/SGR terminal output."
          },
          "truncated": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "BridgeConfig": {
        "type": "object",
        "required": [
          "build"
        ],
        "properties": {
          "build": {
            "type": "string"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "bridge",
          "agents",
          "shellPanes",
          "workspaces",
          "tabs",
          "sessions",
          "ts"
        ],
        "properties": {
          "bridge": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ]
          },
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "shellPanes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "workspaces": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tabs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "isPrimary": {
                  "type": "boolean"
                },
                "reachable": {
                  "type": "boolean"
                },
                "agents": {
                  "type": "integer"
                },
                "working": {
                  "type": "integer"
                },
                "blocked": {
                  "type": "integer"
                }
              }
            }
          },
          "ts": {
            "type": "integer"
          }
        }
      },
      "Agent": {
        "type": "object",
        "properties": {
          "paneId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "workspaceLabel": {
            "type": "string"
          },
          "tabId": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "working",
              "blocked",
              "done",
              "unknown"
            ]
          },
          "cwd": {
            "type": "string"
          },
          "focused": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent",
              "shell"
            ]
          }
        }
      },
      "WorkspaceFiles": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "directory"
                  ]
                }
              }
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "WorkspaceFile": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "content": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "GitStatus": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "isRepo": {
            "type": "boolean"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream": {
            "type": [
              "string",
              "null"
            ]
          },
          "ahead": {
            "type": "integer"
          },
          "behind": {
            "type": "integer"
          },
          "insertions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GitDiff": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "CreateResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "pane"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "pane": {
                "$ref": "#/components/schemas/CreatedPane"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ActionResponse"
          }
        ]
      },
      "CreatedPane": {
        "type": "object",
        "required": [
          "paneId",
          "workspaceId",
          "workspaceLabel",
          "tabId",
          "cwd"
        ],
        "properties": {
          "paneId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "workspaceLabel": {
            "type": "string"
          },
          "tabId": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          }
        }
      },
      "LifecycleError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Conversation": {
        "type": "object",
        "required": [
          "id",
          "session",
          "kind",
          "cwd",
          "paneId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^conversation_[0-9a-f-]{36}$"
          },
          "session": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pi",
              "claude"
            ]
          },
          "cwd": {
            "type": "string"
          },
          "paneId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "closed",
              "unavailable",
              "starting"
            ]
          }
        }
      },
      "ConversationResult": {
        "type": "object",
        "required": [
          "conversation"
        ],
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/Conversation"
          }
        }
      },
      "AgentKinds": {
        "type": "object",
        "required": [
          "session",
          "agents"
        ],
        "properties": {
          "session": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "availability",
                "version",
                "reason"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "pi",
                    "claude"
                  ]
                },
                "availability": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "unknown"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "TailscaleServeIdentity": {
        "type": "apiKey",
        "in": "header",
        "name": "Tailscale-User-Login",
        "description": "Injected by Tailscale Serve for remote traffic. Do not manufacture this header; configure `HERDR_RELAY_TRUSTED_USER` on the relay."
      },
      "NativeMutation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Herdr-Client",
        "description": "Set to `herdr-mobile-v1` only for a native non-browser mutation without an Origin header. Browser requests use same-origin protection instead."
      }
    }
  }
}
