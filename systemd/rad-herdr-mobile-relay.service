# Reference systemd --user unit. `scripts/relay-ctl.sh start` generates a copy of this with
# absolute paths filled in at ~/.config/systemd/user/rad-herdr-mobile-relay.service. Edit + use this
# directly only if you prefer to manage it by hand.
#
#   cp systemd/rad-herdr-mobile-relay.service ~/.config/systemd/user/
#   (edit the @PLACEHOLDERS@ below)
#   systemctl --user daemon-reload && systemctl --user enable --now rad-herdr-mobile-relay

[Unit]
Description=Herdr Mobile Relay
After=default.target
# Never give up restarting — a phone-only operator can't run 'systemctl reset-failed'.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PLUGIN_ROOT@
ExecStart=@BUN@ run @PLUGIN_ROOT@/bridge/index.ts
Restart=on-failure
RestartSec=5
# Keep owner sockets visible to the user's SSH sessions; do not isolate them in PrivateTmp.
# Restrict new socket/state files and deny privilege escalation.
NoNewPrivileges=yes
UMask=0077
Environment=HERDR_SOCKET_PATH=%h/.config/herdr/herdr.sock
Environment=HERDR_RELAY_SOCKET=%h/.local/state/rad-herdr-mobile-relay/relay.sock
Environment=HERDR_PLUGIN_CONFIG_DIR=%h/.config/rad-herdr-mobile-relay
EnvironmentFile=-%h/.config/rad-herdr-mobile-relay/.env

[Install]
WantedBy=default.target
