    },
    {
      "name": "Panes",
      "description": "Read and drive terminal panes."
    },
    {
      "name": "Workspace",
      "description": "Workspace, tab, worktree, file and Git operations."
    },
    {
      "name": "Notifications",
      "description": "Web Push subscriptions and relay-wide preferences."
    },
    {
      "name": "WebSockets",
      "description": "Protocol summaries; use the ACP guide for the structured agent channel."
    }
  ],
