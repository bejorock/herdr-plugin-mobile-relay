# Owner-scoped SSH relay. No TCP listener, Tailscale Serve or proxy identity settings.
# Copy into the plugin config directory as .env (mode 0600); parsed as data, never shell code.

# Public HTTP/SSE/WebSocket Unix socket. Default: <stateDir>/relay.sock.
# Use a dedicated owner-private directory; full path must be <=100 UTF-8 bytes.
# HERDR_RELAY_SOCKET=/home/you/.local/state/rad-herdr-mobile-relay/relay.sock

# Herdr's EXISTING control socket, distinct from relay.sock and private agent-hook.sock.
# HERDR_SOCKET_PATH=/home/you/.config/herdr/herdr.sock
# State defaults to HERDR_PLUGIN_STATE_DIR when injected by Herdr, otherwise:
# HERDR_RELAY_STATE_DIR=/home/you/.local/state/rad-herdr-mobile-relay

HERDR_RELAY_POLL_MS=1500
HERDR_RELAY_POLL_IDLE_MS=12000
HERDR_RELAY_READ_LINES=200
HERDR_RELAY_SUBMIT_KEYS=Enter
HERDR_RELAY_MULTI_SESSION=on

# Optional owner-attested PATH used by Herdr's intended interactive launch shell.
# Discovery checks fixed pi/claude executable files here without executing them. This does NOT
# change Herdr launch behavior. Omit if unknown; installed-hook-only evidence remains unknown.
# HERDR_RELAY_AGENT_PATH=/home/you/.local/bin:/home/you/.bun/bin:/usr/local/bin:/usr/bin:/bin

# Native clients send X-Herdr-Client: herdr-mobile-v1 on writes and WebSocket upgrades.
# Browser origins are denied by default. Optional exact origins for a deliberately configured
# local/backend client bridge; this does not add CORS or authenticate a user.
# HERDR_RELAY_ALLOWED_ORIGINS=http://127.0.0.1:3000

# SSH authentication/host verification and SFTP permissions belong to the owner/client.
# No SSH listener or SFTP implementation is included in this daemon.
